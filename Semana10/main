import menu
import actions


def main():
    file_path = "student_file.csv"
    while True:
        operation = menu.initial_menu()
        if operation == "1":
            actions.add_new_student_to_CSV(file_path)
        elif operation == "2":
            actions.view_existing_student(file_path)
        elif operation == "3":
            actions.view_top_three(file_path)
        elif operation == "4":
            actions.view_student_average(file_path)
        elif operation == "5":
            actions.delete_existing_student(file_path)
        elif operation == "6":
            actions.view_failed_students(file_path)
        elif operation == "7":
            print("Saliendo del sistema :D")
            print("\n")
            break
        else:
            print("Opción no válida, intente de nuevo")



if __name__ == "__main__":
    main()


operation = menu.initial_menu()
print(f"DEBUG: operation = '{operation}'")